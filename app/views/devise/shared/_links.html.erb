<%- if controller_name != 'sessions' %>
  <div class = "text-center mt-4 pt-2 border-top">
    <span class="text-secondary small">Já possui uma conta?</span>
  <%= link_to "Conecte-se", new_session_path(resource_name), class: "text-primary fw-bold small text-decoration-none ms-1 hover-underline" %>
  </div>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <div class = "text-center">
    <span class="text-secondary small">Ainda não possui uma conta?</span>
    <%= link_to "Cadastre-se", new_registration_path(resource_name), class: "text-primary fw-bold small text-decoration-none ms-1 hover-underline" %>
  </div>

<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <div class="d-flex justify-content-center align-items-baseline mb-1">  
    <%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "text-primary fw-bold small text-decoration-none ms-1 hover-underline" %>
  </div>
  
<% end %>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <p><%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name) %></p>
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <p><%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name) %></p>
<% end %>

<%- if devise_mapping.omniauthable? %>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <p><%= button_to "Sign in with #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false } %></p>
  <% end %>
<% end %>
