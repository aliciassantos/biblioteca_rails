<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
  <div class="col-md-5">
    <div class="card shadow rounded-4 border-0 p-4 bg-white">
      <div class="card-body">
        
        <div class="text-center mb-4">
          <h2 class="fw-bold text-dark">BiblioLili&Nana</h2>
          <p class="text-muted small">Insira suas credenciais para acessar o sistema</p>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), data: { turbo: false }) do |f| %>
          
          <div class="form-group mb-3">
            <%= f.label :email, "E-mail institucional", class: "form-label fw-semibold text-secondary small" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg rounded-3 fs-6", placeholder: "nome@exemplo.com" %>
          </div>

          <div class="form-group mb-3">
            <%= f.label :password, "Senha de acesso", class: "form-label fw-semibold text-secondary small" %>
            <%= f.password_field :password, autocomplete: "current-password", class: "form-control form-control-lg rounded-3 fs-6", placeholder: "••••••••" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="form-check mb-4 text-start">
              <%= f.check_box :remember_me, class: "form-check-input" %>
              <%= f.label :remember_me, "Manter-me conectado", class: "form-check-label text-muted small" %>
            </div>
          <% end %>

          <div class="d-grid gap-2 mb-3">
            <%= f.submit "Entrar no Sistema", class: "btn btn-primary btn-lg fw-bold rounded-3 shadow-sm py-2 fs-6" %>
          </div>

        <% end %>

        <div class="text-center mt-3 border-top pt-3">
          <%= render "devise/shared/links" %>
        </div>

      </div>
    </div>
  </div>
</div>