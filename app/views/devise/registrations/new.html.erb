<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
  <div class="col-md-5">
    <div class="card shadow rounded-4 border-0 p-4 bg-white">
      <div class="card-body">
        <h2 class="text-center mb-4 fw-bold text-dark">Cadastre-se</h2>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="field-group mb-3">
            <%= f.label :email, "E-mail institucional", class: "form-label fw-semibold text-secondary small" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg rounded-3 fs-6" %>
          </div>

          <div class="field-group mb-3">
            <div class="d-flex justify-content-between align-items-baseline mb-1">
              <%= f.label :password, "Senha", class: "form-label fw-semibold text-secondary small mb-0" %>
              
              <% if @minimum_password_length %>
                <span class="text-secondary small" style="font-size: 0.75rem;">
                  <em>(<%= @minimum_password_length %> caracteres mínimos)</em>
                </span>
              <% end %>
            </div>
            
            <%= f.password_field :password, autocomplete: "new-password", class: "form-control form-control-lg rounded-3 fs-6" %>
          </div>

          <div class="field-group mb-3">
            <%= f.label :password_confirmation, "Confirmação de senha", class: "form-label fw-semibold text-secondary small" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control form-control-lg rounded-3 fs-6" %>
          </div>

          <div class="actions d-grid gap-2 mb-3">
            <%= f.submit "Cadastrar-se", class: "btn btn-primary btn-lg fw-bold rounded-3 shadow-sm py-2 fs-6" %>
          </div>
        <% end %>

        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>      
