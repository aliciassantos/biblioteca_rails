<%= form_with(model: emprestimo) do |form| %>
  <!--Verifica se há erros no formulário-->
  <% if emprestimo.errors.any? %>
    <div class="alert alert-danger shadow-sm rounded-3 mb-4">
      <h5 class="fw-bold mb-2">⚠️ O formulário contém erros:</h5>
      <ul class="mb-0 small">
        <% emprestimo.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-md-12">
      <%= form.label :aluno_id_input, "ID do Aluno", class: "form-label fw-bold text-secondary small" %>
      <%= form.text_field :aluno_id_input, class: "form-control shadow-sm", placeholder: "Insira o ID do Aluno" %>
    </div>

    <div class="col-md-6">
      <%= form.label :isbn_livro, "ISBN", class: "form-label fw-bold text-secondary small" %>
      <%= form.text_field :isbn_livro, class: "form-control shadow-sm", placeholder: "Ex: 0983341752153", maxlength: 13 %>
    </div>

    <div class="col-md-6">
      <%= form.label :data_devolucao, "Data de devolução", class: "form-label fw-bold text-secondary small" %>
      <%= form.date_field :data_devolucao, class: "form-control shadow-sm" %>
    </div>

    </div> <%= form.hidden_field :data_emprestimo, value: Date.today %>
    
  <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
    <%= link_to "Voltar", emprestimos_path, class: "btn btn-light border px-4" %>
    <%= form.submit "Realizar Empréstimo", class: "btn btn-primary px-4 fw-bold shadow-sm" %>
  </div>
<% end %>
