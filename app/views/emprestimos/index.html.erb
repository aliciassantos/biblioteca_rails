<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-warning font-weight-bold">Controle de Empréstimos</h1>
    <%= link_to "Novo Empréstimo", new_emprestimo_path, class: "btn btn-warning text-white px-4 shadow-sm" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <table class="table table-striped table-hover mb-0">
        <thead class="table-dark">
          <tr>
            <th>Aluno</th>
            <th>Livro</th>
            <th>Data de Empréstimo</th>
            <th>Data de Devolução</th>
            <th>Status</th>
            <th class="text-center">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if @emprestimos.any? %>
            <% @emprestimos.each do |emprestimo| %>
              <tr>
                <td class="align-middle"><%= emprestimo.aluno.nome_completo %></td>
                <td class="align-middle fw-bold"><%= emprestimo.livro.titulo %></td>
                <td class="align-middle"><%= emprestimo.data_emprestimo.strftime('%d/%m/%Y') %></td>
                <td class="align-middle"><%= emprestimo.data_devolucao.strftime('%d/%m/%Y') %></td>
                <td class="align-middle">
                  <% if emprestimo.status == "Devolvido" %>
                    <span class="badge bg-success">Devolvido</span>
                  <% else %>
                    <span class="badge bg-danger">Emprestado</span>
                  <% end %>
                </td>
                <td class="text-center align-middle">
                  <%= link_to "Ver", emprestimo, class: "btn btn-sm btn-info text-white me-1" %>
                  <%= link_to "Editar", edit_emprestimo_path(emprestimo), class: "btn btn-sm btn-warning text-white me-1" %>
                  <%= link_to "Excluir", emprestimo, method: :delete, data: { confirm: "Tem certeza?" }, class: "btn btn-sm btn-danger" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="text-center text-muted p-4">
                Nenhum empréstimo registrado no momento.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @emprestimos if @emprestimos.respond_to?(:current_page) %>
  </div>
</div>>
