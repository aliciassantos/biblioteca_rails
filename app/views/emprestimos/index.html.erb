<% content_for :title, "Empréstimos - BiblioLili&Nana" %>

<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div> 
      <h1 class="fw-bold text-dark mb-1">Registro de Empréstimos</h1>
      <p class="text-muted small mb-0">Gerenciamento de empréstimos no sistema BiblioLili&Nana.</p>
    </div> 
    <div class="d-flex gap-2">
      <%= link_to root_path, class: "btn btn-outline-secondary shadow-sm d-inline-flex align-items-center gap-2 fw-bold" do %>
        🏠 Voltar ao Menu
      <% end %>

      <%= link_to emprestimos_path(format: :pdf), class: "btn btn-danger shadow-sm d-inline-flex align-items-center gap-2 fw-bold" do %>
        📊 Gerar PDF (Prawn)
      <% end %>

      <%= link_to new_emprestimo_path, class: "btn btn-primary shadow-sm d-inline-flex align-items-center gap-2 fw-bold" do %>
        ➕ Novo Empréstimo
      <% end %>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-6 col-lg-5">
      <%= form_with url: emprestimos_path, method: :get, local: true do |f| %>
        <div class="input-group shadow-sm rounded-3 overflow-hidden">
          <span class="input-group-text bg-light border-end-0 text-muted">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
              <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
            </svg>
          </span>
          
          <%= f.text_field :search, 
                           value: params[:search], 
                           placeholder: "Buscar por ID Aluno, nome do aluno, livro ou status...", 
                           class: "form-control bg-light border-start-0 ps-1",
                           autocomplete: "off" %>
          
          <%= f.submit "Pesquisar", class: "btn btn-dark fw-bold px-3" %>
          
          <% if params[:search].present? %>
            <%= link_to "Limpar", emprestimos_path, class: "btn btn-outline-secondary px-3 d-flex align-items-center" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card shadow-sm border-0 rounded-3 overflow-hidden bg-white">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 bg-white">
        <thead class="table-dark">
          <tr>
            <th scope="col" class="ps-4">ID do Aluno</th>
            <th scope="col">Nome do Aluno</th>
            <th scope="col">Nome do Livro</th>
            <th scope="col">Data do Empréstimo</th>
            <th scope="col">Data de Devolução</th>
            <th scope="col">Status</th>
            <th scope="col" class="text-center pe-4">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if @emprestimos.any? %>
            <% @emprestimos.each do |emprestimo| %>
              <tr class="bg-white">
                <td class="ps-4 text-secondary fw-semibold"><%= emprestimo.aluno_id %></td>
                <td><%= emprestimo.aluno&.nome_completo || "Aluno Removido" %></td>
                <td class="fw-bold text-dark"><%= emprestimo.livro&.titulo || "Livro Removido" %></td>
                <td><%= emprestimo.data_emprestimo.strftime('%d/%m/%Y') %></td>
                <td><%= emprestimo.data_devolucao.strftime('%d/%m/%Y') %></td>
                <td>
                  <% if emprestimo.status == "Devolvido" %>
                    <span class="badge bg-success">Devolvido</span>
                  <% elsif emprestimo.devolucao_vencida? %>
                    <span class="badge bg-danger">Em atraso</span>
                  <% else %>
                    <span class="badge bg-primary">Emprestado</span>
                  <% end %>
                </td>
                <td class="text-center pe-4 align-middle">
                  <div class="d-flex gap-2 justify-content-center">
                    <% # Botão Ver - Estilo Outline Info %>
                    <%= link_to "Ver", emprestimo_path(emprestimo.aluno_id, emprestimo.livro_id), 
                                class: "btn btn-sm btn-outline-info flex-fill" %>
                    
                    <% # Botão Atualizar - Estilo Outline Warning %>
                    <%= link_to "Atualizar", edit_emprestimo_path(emprestimo.aluno_id, emprestimo.livro_id), 
                                class: "btn btn-sm btn-outline-warning flex-fill" %>
                    
                    <% # Botão Remover - Estilo Outline Danger %>
                    <%= link_to "Remover", emprestimo_path(emprestimo.aluno_id, emprestimo.livro_id), 
                                data: { turbo_method: :delete, turbo_confirm: "Deseja remover este empréstimo?" }, 
                                class: "btn btn-sm btn-outline-danger flex-fill" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">Nenhum empréstimo registrado no momento.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @emprestimos if @emprestimos.respond_to?(:current_page) %>
  </div>
</div>