<div id="<%= dom_id aluno %>">
  <div>
    <strong>Nome completo:</strong>
    <%= aluno.nome_completo %>
  </div>

  <div>
    <strong>Cpf:</strong>
    <%= aluno.cpf %>
  </div>

  <div>
    <strong>Matricula:</strong>
    <%= aluno.matricula %>
  </div>

  <div>
    <strong>Data nascimento:</strong>
    <%= aluno.data_nascimento %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= aluno.email %>
  </div>

  <div>
    <strong>Telefone:</strong>
    <%= aluno.telefone %>
  </div>

</div>
