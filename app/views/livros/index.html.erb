<% content_for :title, "Livros - BiblioLili&Nana" %>

<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold text-dark mb-1">Consulta de Livros</h1>
      <p class="text-muted small mb-0">Gerenciamento de livros no sistema BiblioLili&Nana.</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to root_path, class: "btn btn-outline-secondary shadow-sm d-inline-flex align-items-center gap-2 fw-bold" do %>
        🏠 Voltar ao Menu
      <% end %>

      <% # Requisito d) PDF com Prawn - Mantém o filtro de busca ativo no PDF %>
      <%= link_to livros_path(format: :pdf, search: params[:search]), class: "btn btn-danger shadow-sm d-inline-flex align-items-center gap-2 fw-bold" do %>
        📊 Gerar PDF (Prawn)
      <% end %>
      
      <%= link_to new_livro_path, class: "btn btn-primary shadow-sm d-inline-flex align-items-center gap-2 fw-bold" do %>
        ➕ Novo Livro
      <% end %>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-6 col-lg-5"> <%= form_with url: livros_path, method: :get, local: true do |f| %>
        <div class="input-group shadow-sm rounded-3 overflow-hidden">
          <span class="input-group-text bg-light border-end-0 text-muted">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
              <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
            </svg>
          </span>
          
          <%= f.text_field :search, 
                          value: params[:search], 
                          placeholder: "Buscar por título, autor, editora ou ISBN", 
                          class: "form-control bg-light border-start-0 ps-1",
                          autocomplete: "off" %>
          
          <%= f.submit "Pesquisar", class: "btn btn-dark fw-bold px-3" %>
          
          <% if params[:search].present? %>
            <%= link_to "Limpar", livros_path, class: "btn btn-outline-secondary px-3 d-flex align-items-center" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th scope="col" class="ps-4">ID</th>
            <th scope="col">Título</th>
            <th scope="col">Autor</th>
            <th scope="col">Editora</th>
            <th scope="col">ISBN</th>
            <th scope="col">Ano de Publicação</th>
            <th scope="col">Quantidade em estoque</th>
            <th scope="col" class="text-center pe-4">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if @livros.any? %>
            <% @livros.each do |livro| %>
              <tr>
                <td class="ps-4 text-secondary fw-semibold"><%= livro.id %></td>
                <td><span class="fw-bold text-dark"><%= livro.titulo %></span></td>
                <td><code class="text-secondary"><%= livro.autor %></code></td>
                <td><%= livro.editora %></td>
                <td><%= livro.isbn %></td>
                <td><%= livro.ano_publicacao %></td>
                <td><%= livro.quantidade_estoque %></td>
                <td class="text-center pe-4">
                  <div class="d-flex gap-2 justify-content-center">
                    <%= link_to "Ver", livro, class: "btn btn-sm btn-outline-info flex-fill" %>
                    <%= link_to "Editar", edit_livro_path(livro), class: "btn btn-sm btn-outline-warning flex-fill" %>
                    <%= link_to "Remover", livro, data: { turbo_method: :delete, turbo_confirm: "Deseja remover este livro?" }, class: "btn btn-sm btn-outline-danger flex-fill" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">Nenhum livro encontrado no sistema.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% # Requisito a) Paginação do Kaminari %>
  <div class="d-flex justify-content-center mt-4">
    <%= paginate @livros if @livros.respond_to?(:current_page) %>
  </div>
</div>